{
  "name": "webintelligent",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Local website navigation, element and request auditor",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "NODE_ENV=development node --watch server/index.mjs",
    "build": "vite build",
    "check": "npm run build && npm test",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/smoke.mjs",
    "browser:install": "playwright install chromium",
    "format": "prettier --write src server tests public vite.config.js index.html README.md",
    "smoke:stage1": "node tests/stage1-smoke.mjs",
    "smoke:stage2": "node tests/stage2-smoke.mjs",
    "smoke:stage3": "node tests/stage3-smoke.mjs",
    "smoke:stage4": "node tests/stage4-smoke.mjs",
    "smoke:stage5": "node tests/stage5-smoke.mjs",
    "smoke:stage6": "node tests/stage6-smoke.mjs",
    "verify:package": "node tools/verify-package.mjs",
    "smoke:menus": "node tests/workspace-smoke.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "express": "5.2.1",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.48.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "vite": "8.3.1"
  }
}
